# Cloudflare Pages response headers.
# Files in /assets/ have a content hash in their name, so they never change and may be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and manifest must always be fetched fresh, so new versions are noticed.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
